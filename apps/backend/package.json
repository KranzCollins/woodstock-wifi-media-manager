{
  "name": "postiz-backend",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "dotenv -e ../../.env -- nest start --watch --entryFile=./apps/backend/src/main",
    "build": "cross-env NODE_ENV=production nest build",
    "start": "dotenv -e ../../.env -- node --experimental-require-module ./dist/apps/backend/src/main.js",
    "pm2": "pm2 start pnpm --name backend -- start",
    "build:managed-runtime": "cross-env NODE_ENV=production nest build --path ./tsconfig.managed-runtime.json",
    "start:managed-runtime": "node --experimental-require-module ./dist-managed-runtime/apps/backend/src/managed-runtime/main.js"
  },
